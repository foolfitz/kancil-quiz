{
    "games": [
        {
            "id": "balloon-archer",
            "version": "0.1.0",
            "title": {
                "zh-TW": "射氣球"
            },
            "scoreLabel": {
                "zh-TW": "星星"
            },
            "requires": {
                "shape": "mcq",
                "minRounds": 1,
                "optionCount": {
                    "min": 2,
                    "max": 6
                },
                "renders": {
                    "prompt": [
                        "text",
                        "image",
                        "audio"
                    ],
                    "option": [
                        "text",
                        "image"
                    ]
                },
                "scored": true
            },
            "optionsSchema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "射氣球的設定",
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "seconds",
                    "speed"
                ],
                "properties": {
                    "seconds": {
                        "title": "遊戲時間（秒）",
                        "description": "時間到就結束。題目射完會重新洗牌再輪一次，射得又快又準，星星就越多；第一輪沒輪到的題目算答錯。",
                        "type": "integer",
                        "minimum": 30,
                        "maximum": 180,
                        "default": 60
                    },
                    "speed": {
                        "title": "氣球的速度",
                        "description": "氣球往上飄得多快。每多輪一次，氣球會再快一點。",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "slow",
                                "title": "慢"
                            },
                            {
                                "const": "normal",
                                "title": "中"
                            },
                            {
                                "const": "fast",
                                "title": "快"
                            }
                        ],
                        "default": "slow"
                    }
                }
            },
            "defaultOptions": {
                "seconds": 60,
                "speed": "slow"
            }
        },
        {
            "id": "card-wall",
            "version": "0.1.0",
            "title": {
                "zh-TW": "圖卡牆"
            },
            "requires": {
                "shape": "card",
                "minRounds": 1,
                "renders": {
                    "front": [
                        "text",
                        "romanization",
                        "image",
                        "audio"
                    ],
                    "back": [
                        "text",
                        "romanization",
                        "image",
                        "audio"
                    ]
                },
                "scored": false
            },
            "optionsSchema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "圖卡牆的設定",
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "startWith",
                    "autoPlayAudio"
                ],
                "properties": {
                    "startWith": {
                        "title": "先顯示哪一面",
                        "description": "點卡片翻面，看另一面。",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "front",
                                "title": "題目那一面"
                            },
                            {
                                "const": "back",
                                "title": "答案那一面"
                            }
                        ],
                        "default": "front"
                    },
                    "autoPlayAudio": {
                        "title": "翻到有發音的那一面時自動播放",
                        "type": "boolean",
                        "default": true
                    }
                }
            },
            "defaultOptions": {
                "startWith": "front",
                "autoPlayAudio": true
            }
        },
        {
            "id": "flash-cards",
            "version": "0.1.0",
            "title": {
                "zh-TW": "字卡"
            },
            "requires": {
                "shape": "card",
                "minRounds": 1,
                "renders": {
                    "front": [
                        "text",
                        "romanization",
                        "image",
                        "audio"
                    ],
                    "back": [
                        "text",
                        "romanization",
                        "image",
                        "audio"
                    ]
                },
                "scored": false
            },
            "optionsSchema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "字卡的設定",
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "startWith",
                    "autoPlayAudio"
                ],
                "properties": {
                    "startWith": {
                        "title": "先顯示哪一面",
                        "description": "學生點卡片翻面，看另一面。",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "front",
                                "title": "題目那一面"
                            },
                            {
                                "const": "back",
                                "title": "答案那一面"
                            }
                        ],
                        "default": "front"
                    },
                    "autoPlayAudio": {
                        "title": "有發音的那一面出現時自動播放",
                        "type": "boolean",
                        "default": true
                    }
                }
            },
            "defaultOptions": {
                "startWith": "front",
                "autoPlayAudio": true
            }
        },
        {
            "id": "match-up",
            "version": "0.1.0",
            "title": {
                "zh-TW": "配對"
            },
            "requires": {
                "shape": "pair",
                "minRounds": 2,
                "renders": {
                    "left": [
                        "text",
                        "romanization",
                        "image",
                        "audio"
                    ],
                    "right": [
                        "text",
                        "romanization",
                        "image"
                    ]
                },
                "scored": true
            },
            "optionsSchema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "配對的設定",
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "pairsPerPage"
                ],
                "properties": {
                    "pairsPerPage": {
                        "title": "每頁最多幾組",
                        "description": "題目比較多時分成幾頁，配完一頁才換下一頁，各頁的組數會盡量平均。平板直向建議不超過 6 組。",
                        "type": "integer",
                        "minimum": 3,
                        "maximum": 8,
                        "default": 6
                    }
                }
            },
            "defaultOptions": {
                "pairsPerPage": 6
            }
        },
        {
            "id": "maze-quiz",
            "version": "0.1.0",
            "title": {
                "zh-TW": "迷宮問答"
            },
            "requires": {
                "shape": "mcq",
                "minRounds": 1,
                "optionCount": {
                    "min": 2,
                    "max": 6
                },
                "renders": {
                    "prompt": [
                        "text",
                        "image",
                        "audio"
                    ],
                    "option": [
                        "text",
                        "image"
                    ]
                },
                "scored": true
            },
            "optionsSchema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "迷宮問答的設定",
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "timerMode",
                    "countDownSeconds",
                    "lives",
                    "difficulty"
                ],
                "properties": {
                    "timerMode": {
                        "title": "計時方式",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "none",
                                "title": "不計時"
                            },
                            {
                                "const": "countUp",
                                "title": "正計時"
                            },
                            {
                                "const": "countDown",
                                "title": "倒數"
                            }
                        ],
                        "default": "countUp"
                    },
                    "countDownSeconds": {
                        "title": "倒數秒數",
                        "description": "計時方式選「倒數」時才有作用；時間到就結束遊戲。",
                        "type": "integer",
                        "minimum": 30,
                        "maximum": 3600,
                        "default": 300
                    },
                    "lives": {
                        "title": "生命數",
                        "description": "被敵人碰到就少一條命，命用完遊戲就結束。",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9,
                        "default": 3
                    },
                    "difficulty": {
                        "title": "難度",
                        "description": "難度只影響敵人移動的速度。",
                        "type": "integer",
                        "oneOf": [
                            {
                                "const": 1,
                                "title": "1（敵人最慢）"
                            },
                            {
                                "const": 2,
                                "title": "2"
                            },
                            {
                                "const": 3,
                                "title": "3（敵人最快）"
                            }
                        ],
                        "default": 2
                    }
                }
            },
            "defaultOptions": {
                "timerMode": "countUp",
                "countDownSeconds": 300,
                "lives": 3,
                "difficulty": 2
            }
        },
        {
            "id": "quiz",
            "version": "0.1.0",
            "title": {
                "zh-TW": "選擇題"
            },
            "requires": {
                "shape": "mcq",
                "minRounds": 1,
                "optionCount": {
                    "min": 2,
                    "max": 6
                },
                "renders": {
                    "prompt": [
                        "text",
                        "image",
                        "audio"
                    ],
                    "option": [
                        "text",
                        "image"
                    ]
                },
                "scored": true
            },
            "optionsSchema": {
                "type": "object",
                "properties": {
                    "revealAnswer": {
                        "type": "boolean",
                        "title": "答錯時顯示正確答案"
                    },
                    "autoAdvance": {
                        "type": "boolean",
                        "title": "作答後自動進入下一題"
                    }
                },
                "additionalProperties": false
            },
            "defaultOptions": {
                "revealAnswer": true,
                "autoAdvance": true
            }
        },
        {
            "id": "spin-wheel",
            "version": "0.1.0",
            "title": {
                "zh-TW": "轉盤"
            },
            "requires": {
                "shape": "card",
                "minRounds": 2,
                "renders": {
                    "front": [
                        "text",
                        "romanization",
                        "image",
                        "audio"
                    ],
                    "back": [
                        "text",
                        "romanization",
                        "image",
                        "audio"
                    ]
                },
                "scored": false
            },
            "optionsSchema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "轉盤的設定",
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "startWith",
                    "sliceLabel",
                    "removeAfterSpin",
                    "autoPlayAudio"
                ],
                "properties": {
                    "startWith": {
                        "title": "轉到時先顯示哪一面",
                        "description": "點卡片翻面，看另一面。",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "front",
                                "title": "題目那一面"
                            },
                            {
                                "const": "back",
                                "title": "答案那一面"
                            }
                        ],
                        "default": "front"
                    },
                    "sliceLabel": {
                        "title": "轉盤上顯示",
                        "type": "string",
                        "oneOf": [
                            {
                                "const": "target",
                                "title": "目標語（例如印尼語）的文字"
                            },
                            {
                                "const": "face",
                                "title": "先顯示那一面的文字"
                            },
                            {
                                "const": "number",
                                "title": "編號（轉到才揭曉）"
                            }
                        ],
                        "default": "target"
                    },
                    "removeAfterSpin": {
                        "title": "轉到的詞從轉盤拿掉，每個詞只會轉到一次",
                        "type": "boolean",
                        "default": true
                    },
                    "autoPlayAudio": {
                        "title": "有發音的那一面出現時自動播放",
                        "type": "boolean",
                        "default": true
                    }
                }
            },
            "defaultOptions": {
                "startWith": "front",
                "sliceLabel": "target",
                "removeAfterSpin": true,
                "autoPlayAudio": true
            }
        },
        {
            "id": "whack-a-mole",
