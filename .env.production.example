# 正式環境的設定（docs/deploy.md）。複製成 .env.production 後填寫；.env.production 不會進 git。

APP_NAME="Kancil Quiz"
APP_ENV=production
APP_DEBUG=false
# 產生方式：docker compose run --rm app php artisan key:generate --show
# 換掉會讓雙重驗證的設定失效，要和備份一起妥善保存
APP_KEY=
# 網站的網址，一定要是 https
APP_URL=https://quiz.example.org
APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en

# 網域。Caddy 依此自動申請 HTTPS 憑證，DNS 要先指向這台主機
SERVER_NAME=quiz.example.org
# 申請憑證時留給 Let's Encrypt 的聯絡信箱（選填）
# CADDY_GLOBAL_OPTIONS="email you@example.org"

LOG_LEVEL=warning

# 作答紀錄保存幾個月（docs/SPEC.md 第 5 節），預設 12
# KANCIL_ATTEMPT_RETENTION_MONTHS=12

# 老師的 Google 登入（docs/deploy.md「Google 登入」）。沒有填的話，只有管理員能用密碼登入
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 隱私權政策與使用條款上的營運者與聯絡信箱（/privacy、/terms）
KANCIL_OPERATOR=
KANCIL_CONTACT_EMAIL=
# 每位老師上傳的檔案總量上限（MB），預設 200；管理員不受限制
# KANCIL_UPLOAD_QUOTA_MB=200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# 寄信：有人檢舉活動時通知管理員。還沒有 SMTP 帳號時先用 log（信只會寫進記錄，檢舉仍會出現在後台）
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@quiz.example.org"
MAIL_FROM_NAME="Kancil Quiz"
