{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "kancil-quiz",
    "private": true,
    "license": "AGPL-3.0-or-later",
    "workspaces": [
        "packages/*",
        "packages/games/*",
        "packages/games/kancil-games/*",
        "packages/games/kancil-materials/*"
    ],
    "type": "module",
    "scripts": {
        "build": "vp build && npm run build:standalone",
        "build:standalone": "vp build packages/player/standalone",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "vue-tsc --noEmit",
        "test": "vp test run",
        "schema:types": "npm run generate -w @kancil-quiz/schema",
        "schema:check": "npm run check -w @kancil-quiz/schema",
        "games:manifest": "vp test run packages/games/manifest.test.ts -u"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.17.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.0.0",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.0"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "concurrently": "^10.0.3",
        "typescript": "^5.2.2",
        "vite": "^8.0.0",
        "vite-plus": "0.3.0",
        "vue-tsc": "^2.2.4"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
